<Window x:Class="FPlusClone.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt hệ thống" Height="480" Width="500" WindowStartupLocation="CenterOwner" Background="#f0f0f0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,20,28,20">

                        <!-- ══ SECTION 1: Luồng & Chrome ══ -->
                        <TextBlock Text="Cấu hình Luồng &amp; Chrome"
                                   FontSize="15" FontWeight="Bold" Foreground="#1a73e8"
                                   Margin="0,0,0,4"/>
                        <Separator Background="#e8f0fe" Margin="0,0,0,16"/>

                        <!-- Đường dẫn profile -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Đường dẫn profile Chrome" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#202124"/>
                                <TextBlock Text="Thư mục lưu trữ profile, để trống sẽ dùng mặc định"
                                           FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                    <TextBox Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" FontSize="12" BorderThickness="0"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="..." Command="{Binding SelectProfilePathCommand}"
                                        Width="30" Margin="4,0,0,0"
                                        Background="#f1f3f4" BorderBrush="#dadce0" BorderThickness="1"
                                        Cursor="Hand"/>
                            </Grid>
                        </Grid>



                        <!-- ══ SECTION 2: Proxy ══ -->
                        <TextBlock Text="Cấu hình Proxy"
                                   FontSize="15" FontWeight="Bold" Foreground="#1a73e8"
                                   Margin="0,4,0,4"/>
                        <Separator Background="#e8f0fe" Margin="0,0,0,16"/>

                        <!-- Chọn Proxy -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Phương thức Proxy" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#202124"/>
                                <TextBlock Text="Chọn loại proxy để sử dụng"
                                           FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                <ComboBox SelectedIndex="{Binding ProxyMethod, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="8,6" FontSize="12" BorderThickness="0"
                                          VerticalContentAlignment="Center" Background="White">
                                    <ComboBoxItem Content="Không dùng"/>
                                    <ComboBoxItem Content="Proxy tĩnh"/>
                                    <ComboBoxItem Content="KiotProxy"/>
                                </ComboBox>
                            </Border>
                        </Grid>

                        <!-- Proxy list section (only visible when IsStaticProxy = true) -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStaticProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Toggle list -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Nhập danh sách proxy tĩnh" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#202124"/>
                                    <TextBlock Text="Tích vào để hiển thị và sửa danh sách proxy"
                                               FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding UseProxy}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Textbox proxy list -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseProxy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Danh sách Proxy  (1 proxy / dòng — ip:port  hoặc  ip:port:user:pass)"
                                           FontSize="11" Foreground="#5f6368" Margin="0,0,0,6"/>
                                <Border BorderBrush="#dadce0" BorderThickness="1">
                                    <TextBox Text="{Binding ProxyList, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="80" Padding="10,8"
                                             FontSize="12" FontFamily="Consolas"
                                             BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Kiot Proxy Key (only visible when IsKiotProxy = true) -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKiotProxy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="KiotProxy API Key" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#202124"/>
                                    <TextBlock Text="Nhập mã key KiotProxy của bạn"
                                               FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                <TextBox Text="{Binding KiotProxyKey, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12" BorderThickness="0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- ══ SECTION 3: Chrome Options ══ -->
                        <TextBlock Text="Tùy chọn Chrome"
                                   FontSize="15" FontWeight="Bold" Foreground="#1a73e8"
                                   Margin="0,20,0,4"/>
                        <Separator Background="#e8f0fe" Margin="0,0,0,16"/>

                        <!-- Phương thức đăng nhập -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Phương thức đăng nhập" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#202124"/>
                                <TextBlock Text="Cách đăng nhập Facebook"
                                           FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" SelectedIndex="{Binding LoginMethod}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Username/Password"/>
                                <ComboBoxItem Content="Cookie"/>
                                <ComboBoxItem Content="Tự động (Cookie -> Pass)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Tắt load ảnh -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Tắt tải ảnh" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#202124"/>
                                <TextBlock Text="Tăng tốc độ chạy, giảm băng thông tiêu thụ"
                                           FontSize="11" Foreground="#5f6368" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding DisableImageLoad}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Lấy Cookie khi login -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Lấy Cookie khi login" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#202124"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding GetCookieOnLogin}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="30" Background="#f4f5f7" BorderBrush="#dadce0" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
            <Button Content="Lưu cài đặt" Width="100" Height="30" Background="#1a73e8" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
