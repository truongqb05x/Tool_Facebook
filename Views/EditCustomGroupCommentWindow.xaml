<Window x:Class="FPlusClone.Views.EditCustomGroupCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nội dung comment theo Group" Height="380" Width="450" WindowStartupLocation="CenterOwner" Background="#f0f0f0" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Group ID:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
        <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1" Background="White" Margin="0,0,0,15">
            <TextBox x:Name="txtGroupId" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderThickness="0" Background="Transparent"/>
        </Border>

        <TextBlock Grid.Row="2" Text="Nội dung comment:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
        <Border Grid.Row="3" BorderBrush="#ccc" BorderThickness="1" Background="White">
            <TextBox x:Name="txtContent" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8" BorderThickness="0" Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="70" Height="28" Margin="0,0,10,0" Background="#fff" BorderBrush="#ccc" BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="Lưu" Width="70" Height="28" Background="#1a73e8" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
