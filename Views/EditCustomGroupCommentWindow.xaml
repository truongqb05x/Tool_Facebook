<Window x:Class="FPlusClone.Views.EditCustomGroupCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nội dung comment theo Group ID" Height="460" Width="480"
        WindowStartupLocation="CenterOwner" Background="#f5f6f8" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Group ID -->
        <TextBlock Text="Group ID:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
        <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,14">
            <TextBox x:Name="txtGroupId" Height="32" VerticalContentAlignment="Center"
                     Padding="10,0" BorderThickness="0" Background="Transparent"/>
        </Border>

        <!-- Loại nội dung -->
        <TextBlock Grid.Row="2" Text="Loại nội dung:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="rbText" Content="📝 Bình luận Text" IsChecked="True"
                         Checked="CommentType_Changed" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbImage" Content="🖼 Đính kèm Ảnh"
                         Checked="CommentType_Changed" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Panel Text -->
        <StackPanel x:Name="panelText" Grid.Row="4" Margin="0,0,0,0">
            <TextBlock Text="Nội dung text:" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
        </StackPanel>

        <!-- TextBox nội dung (chỉ hiện khi Text) -->
        <Border x:Name="borderContent" Grid.Row="5" BorderBrush="#ccc" BorderThickness="1"
                Background="White" CornerRadius="4" Margin="0,0,0,0">
            <TextBox x:Name="txtContent" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="10" BorderThickness="0"
                     Background="Transparent" FontSize="12"/>
        </Border>

        <!-- Panel Image (ẩn mặc định) -->
        <StackPanel x:Name="panelImage" Grid.Row="5" Visibility="Collapsed">
            <TextBlock Text="Đường dẫn ảnh:" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#ccc" BorderThickness="1" Background="White" CornerRadius="4">
                    <TextBox x:Name="txtImagePath" Height="32" VerticalContentAlignment="Center"
                             Padding="10,0" BorderThickness="0" Background="Transparent" IsReadOnly="True"/>
                </Border>
                <Button Grid.Column="1" Content="Chọn ảnh" Click="BrowseImage_Click"
                        Background="#1a73e8" Foreground="White" BorderThickness="0"
                        Padding="12,0" Margin="6,0,0,0" Height="32" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1557b0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <TextBlock Text="Nội dung text kèm theo (tuỳ chọn):" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
            <Border BorderBrush="#ccc" BorderThickness="1" Background="White" CornerRadius="4" Height="90">
                <TextBox x:Name="txtImageCaption" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Padding="10" BorderThickness="0"
                         Background="Transparent" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="75" Height="30" Margin="0,0,10,0"
                    Background="#fff" BorderBrush="#ccc" BorderThickness="1" Cursor="Hand" Click="Cancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f0f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Lưu" Width="75" Height="30"
                    Background="#1a73e8" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="Save_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1557b0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
