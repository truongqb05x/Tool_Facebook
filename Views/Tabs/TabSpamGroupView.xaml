<UserControl x:Class="FPlusClone.Views.Tabs.TabSpamGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FPlusClone.Views.Controls"
             xmlns:vm="clr-namespace:FPlusClone.ViewModels"
             Background="#f0f0f0">
    <UserControl.DataContext>
        <vm:TabSpamGroupViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DATA GRID & TÀI KHOẢN -->
        <Border Grid.Column="0" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="10">
            <controls:TaskAccountManagerView />
        </Border>

        <!-- CỘT PHẢI: CẤU HÌNH -->
        <Border Grid.Column="2" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CẤU HÌNH SPAM GROUP" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                <!-- Cấu hình hành động & nút cài đặt nâng cao -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <CheckBox Content="Hành động trước bình luận" IsChecked="{Binding ActionBeforePost}" VerticalAlignment="Center" Width="200"/>
                        <Button Content="⚙ Cài đặt" Command="{Binding OpenActionConfigCommand}" CommandParameter="Before" Padding="5,2" Background="#f8f9fa" BorderBrush="#ccc" Cursor="Hand"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="Hành động sau bình luận" IsChecked="{Binding ActionAfterPost}" VerticalAlignment="Center" Width="200"/>
                        <Button Content="⚙ Cài đặt" Command="{Binding OpenActionConfigCommand}" CommandParameter="After" Padding="5,2" Background="#f8f9fa" BorderBrush="#ccc" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Nút mở Cài đặt nâng cao -->
                    <Button Click="BtnAdvancedSettings_Click" HorizontalAlignment="Left" Background="#f8f9fa" BorderBrush="#ccc" Foreground="#333" FontWeight="SemiBold" FontSize="13" Padding="15,6" Cursor="Hand" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e2e6ea"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙ Cài đặt nâng cao" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nội dung chính -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: Comment theo Group ID -->
                    <StackPanel Grid.Column="0">
                        <!-- Header + nút Thêm -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Nội dung comment " FontSize="12" FontWeight="SemiBold" Foreground="#444" VerticalAlignment="Center"/>
                            <Button Content="+ Thêm" Command="{Binding AddCustomGroupCommentCommand}"
                                    HorizontalAlignment="Right" Background="#1a73e8" Foreground="White"
                                    BorderThickness="0" Padding="12,0" Cursor="Hand" Height="28">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1557b0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- DataGrid danh sách comment theo ID -->
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc">
                            <DataGrid x:Name="customCommentsGrid"
                                      ItemsSource="{Binding CustomGroupCommentsList}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                      Background="White" RowBackground="White" AlternatingRowBackground="#f8f9fa"
                                      BorderThickness="0" HorizontalGridLinesBrush="#eee" VerticalGridLinesBrush="#eee"
                                      RowHeight="26">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Sửa" Command="{Binding PlacementTarget.Tag.EditCustomGroupCommentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Xóa" Command="{Binding PlacementTarget.Tag.DeleteCustomGroupCommentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group ID" Binding="{Binding GroupId}" Width="110" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding TypeLabel}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Text="💡 Nhấn chuột phải vào dòng để Sửa / Xóa." FontSize="10" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- CỘT PHẢI: Log & Điều khiển -->
                    <Grid Grid.Column="2">
                        <Border Background="#f8f9fa" BorderBrush="#dadce0" BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Nút Bắt đầu / Dừng -->
                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nút Bắt đầu -->
                                    <Button Grid.Column="0" Command="{Binding StartTaskCommand}" Background="#109c64" Foreground="White" Cursor="Hand" BorderThickness="0" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Polygon Points="0,0 10,5 0,10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bắt đầu" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0d8555"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#a0d8c0"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Nút Dừng -->
                                    <Button Grid.Column="2" Click="BtnStop_Click" Background="White" BorderBrush="#c82333" Foreground="#c82333" Cursor="Hand" BorderThickness="1" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle Width="8" Height="8" Fill="#c82333" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Dừng" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#fff5f5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Khung hiển thị log -->
                                <Border Grid.Row="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,15">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding LogText}" IsReadOnly="True" BorderThickness="0" Padding="8" Background="Transparent" Foreground="#444" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Trạng thái chạy -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <!-- Đang chạy icon (spinner) -->
                                    <Grid Width="22" Height="22" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Stroke="#e0e0e0" StrokeThickness="2" Width="18" Height="18"/>
                                        <Path Data="M 11,2 A 9,9 0 0 1 20,11" Stroke="#1a73e8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                    </Grid>

                                    <!-- Đã dừng icon -->
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đã dừng">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Rectangle Width="8" Height="1.5" Fill="#666" RadiusX="0.5" RadiusY="0.5"/>
                                    </Border>

                                    <!-- Đã kết thúc icon -->
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="6" Height="6" Fill="#17509c"/>
                                    </Border>

                                    <!-- Pill text -->
                                    <Border CornerRadius="15" Padding="15,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#f4f5f7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                        <Setter Property="Background" Value="#eef2fa"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                            <Setter Property="Foreground" Value="#1a73e8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                                            <Setter Property="Foreground" Value="#17509c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
