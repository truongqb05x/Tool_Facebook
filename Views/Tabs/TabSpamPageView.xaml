<UserControl x:Class="FPlusClone.Views.Tabs.TabSpamPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FPlusClone.Views.Controls"
             xmlns:vm="clr-namespace:FPlusClone.ViewModels"
             Background="#f0f0f0">
    <UserControl.DataContext>
        <vm:TabSpamPageViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DATA GRID & TÀI KHOẢN -->
        <Border Grid.Column="0" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="10">
            <controls:TaskAccountManagerView />
        </Border>

        <!-- CỘT PHẢI: CẤU HÌNH -->
        <Border Grid.Column="2" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CẤU HÌNH SPAM COMMENT PAGE" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Bình luận bằng Text" IsChecked="{Binding IsTextComment}" Margin="0,0,20,0" FontWeight="SemiBold"/>
                            <RadioButton Content="Bình luận bằng Ảnh" IsChecked="{Binding IsImageComment}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- GIAO DIỆN TEXT COMMENT -->
                        <StackPanel Visibility="{Binding IsTextComment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nội dung Text (mỗi dòng 1 nội dung)" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,6"/>
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc">
                                <TextBox Text="{Binding CommentsText}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8" BorderThickness="0" Background="Transparent"/>
                            </Border>
                        </StackPanel>

                        <!-- GIAO DIỆN ẢNH COMMENT -->
                        <StackPanel Visibility="{Binding IsImageComment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Thư mục chứa ảnh" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc">
                                    <TextBox Text="{Binding ImageFolderPath}" Padding="5" BorderThickness="0" Background="Transparent" Height="28" IsReadOnly="True"/>
                                </Border>
                                <Button Grid.Column="1" Content="Chọn thư mục" Command="{Binding SelectImageFolderCommand}" Background="#1a73e8" Foreground="White" BorderThickness="0" Padding="10,0" Margin="5,0,0,0" Cursor="Hand" Height="28"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Danh sách Page ID / Link / Username" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="0,15,0,6"/>
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc">
                            <TextBox Text="{Binding PageList}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="8" BorderThickness="0" FontFamily="Consolas" Background="Transparent"/>
                        </Border>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Giới hạn comment / tài khoản" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                <TextBox Text="{Binding MaxComments}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nghỉ giữa comment (giây)" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                    <TextBox Text="{Binding DelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                </Border>
                                <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                    <TextBox Text="{Binding DelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Số luồng chạy đồng thời" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                <TextBox Text="{Binding MaxThreads}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Xóa ID sau khi xong" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsDeleteAfterComment}" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Border Background="#f8f9fa" BorderBrush="#dadce0" BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Nút Bắt đầu -->
                                    <Button Grid.Column="0" Command="{Binding StartTaskCommand}" Background="#109c64" Foreground="White" Cursor="Hand" BorderThickness="0" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Polygon Points="0,0 10,5 0,10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bắt đầu" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0d8555"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#a0d8c0"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Nút Dừng -->
                                    <Button Grid.Column="2" Command="{Binding StopTaskCommand}" Background="White" BorderBrush="#c82333" Foreground="#c82333" Cursor="Hand" BorderThickness="1" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle Width="8" Height="8" Fill="#c82333" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Dừng" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#fff5f5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                
                                <!-- Khung hiển thị log -->
                                <Border Grid.Row="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,15">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding LogText}" IsReadOnly="True" BorderThickness="0" Padding="8" Background="Transparent" Foreground="#444" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Trạng thái: " FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="#ea4335" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
