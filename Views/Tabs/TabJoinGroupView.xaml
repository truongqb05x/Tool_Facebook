<UserControl x:Class="FPlusClone.Views.Tabs.TabJoinGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FPlusClone.Views.Controls"
             xmlns:vm="clr-namespace:FPlusClone.ViewModels"
             Background="#f0f0f0">
    <UserControl.DataContext>
        <vm:TabJoinGroupViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ CỘT TRÁI: TÀI KHOẢN ══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="10">
            <controls:TaskAccountManagerView />
        </Border>

        <!-- ══ CỘT PHẢI: SETTINGS & LOGS ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 1: CẤU HÌNH -->
            <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="CẤU HÌNH THAM GIA NHÓM" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Config Left -->
                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Danh sách Group ID / Link" FontSize="12" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                                <Button Content="📂 Tải file" Command="{Binding LoadGroupIdsCommand}" HorizontalAlignment="Right" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11"/>
                            </DockPanel>
                            <Border BorderBrush="#dadce0" BorderThickness="1">
                                <TextBox Text="{Binding GroupUids}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Padding="8" BorderThickness="0" FontFamily="Consolas" Background="#fafbfc"/>
                            </Border>
                        </StackPanel>

                        <!-- Config Right -->
                        <StackPanel Grid.Column="2">
                            <Border Background="#f8f9fa" BorderBrush="#dadce0" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nghỉ giữa các nhóm (giây)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Khoảng thời gian random" FontSize="11" Foreground="#888"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                                <TextBox Text="{Binding DelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                                <TextBox Text="{Binding DelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Số luồng chạy đồng thời" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Số lượng tài khoản chạy cùng lúc" FontSize="11" Foreground="#888"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50" VerticalAlignment="Center">
                                            <TextBox Text="{Binding MaxThreads}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- HÀNG 2: CONTROLS & LOG -->
            <Border Grid.Row="1" Background="White" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Nút Bắt đầu -->
                        <Button Grid.Column="0" Command="{Binding StartTaskCommand}" Background="#109c64" Foreground="White" Cursor="Hand" BorderThickness="0" Height="36">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Polygon Points="0,0 10,5 0,10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bắt đầu" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0d8555"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#a0d8c0"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Dừng -->
                        <Button Grid.Column="2" Command="{Binding StopTaskCommand}" Background="White" BorderBrush="#c82333" Foreground="#c82333" Cursor="Hand" BorderThickness="1" Height="36">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="8" Height="8" Fill="#c82333" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dừng" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#fff5f5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <!-- Khung hiển thị log -->
                    <Border Grid.Row="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogText}" IsReadOnly="True" BorderThickness="0" Padding="8" Background="Transparent" Foreground="#444" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Trạng thái chạy -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <!-- Đang chạy icon (spinner) -->
                        <Grid Width="22" Height="22" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Ellipse Stroke="#e0e0e0" StrokeThickness="2" Width="18" Height="18"/>
                            <Path Data="M 11,2 A 9,9 0 0 1 20,11" Stroke="#1a73e8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        
                        <!-- Đã dừng icon (grey circle with minus) -->
                        <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="Đã dừng">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Rectangle Width="8" Height="1.5" Fill="#666" RadiusX="0.5" RadiusY="0.5"/>
                        </Border>
                        
                        <!-- Đã kết thúc icon (grey circle with dot) -->
                        <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="6" Height="6" Fill="#17509c"/>
                        </Border>

                        <!-- Pill text -->
                        <Border CornerRadius="15" Padding="15,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#f4f5f7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                            <Setter Property="Background" Value="#eef2fa"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                <Setter Property="Foreground" Value="#1a73e8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                                <Setter Property="Foreground" Value="#17509c"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
