<Window x:Class="FPlusClone.Views.NuoiTKSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt cấu hình nuôi tài khoản" Height="450" Width="450" WindowStartupLocation="CenterOwner" Background="#f0f0f0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Cảm xúc -->
            <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Cảm xúc sẽ thả khi lướt feed" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="👍 Like" IsChecked="{Binding IsEmotionLike}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="❤️ Tym" IsChecked="{Binding IsEmotionTym}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="🥰 Thương" IsChecked="{Binding IsEmotionThuong}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="😆 Haha" IsChecked="{Binding IsEmotionHaha}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="😮 Wow" IsChecked="{Binding IsEmotionWow}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="😢 Buồn" IsChecked="{Binding IsEmotionBuon}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <CheckBox Content="😡 Phẫn nộ" IsChecked="{Binding IsEmotionPhanNo}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Delay thả cảm xúc (giây)" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding DelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding DelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tương tác Reel -->
            <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc" Padding="15" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tương tác thước phim (Reel)" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Kích hoạt xem và tương tác Reel" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsWatchReel}" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </Grid>

                    <Grid IsEnabled="{Binding IsWatchReel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thời gian xem (giây)" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding ReelTimeMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding ReelTimeMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,10,0,10" IsEnabled="{Binding IsWatchReel}">
                        <CheckBox Content="👍 Like" IsChecked="{Binding IsReelLike}" Margin="0,0,15,5" VerticalAlignment="Center"/>
                        <CheckBox Content="Lưu thước phim" IsChecked="{Binding IsReelSave}" Margin="0,0,15,5" VerticalAlignment="Center"/>
                        <CheckBox Content="Chia sẻ thước phim" IsChecked="{Binding IsReelShare}" Margin="0,0,0,5" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <Grid IsEnabled="{Binding IsWatchReel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Delay thả cảm xúc/tương tác (giây)" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding ReelDelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                            <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                <TextBox Text="{Binding ReelDelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Đọc thông báo -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Đọc thông báo" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Số lượng thông báo" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsReadNoti}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50">
                        <TextBox Text="{Binding ReadNotiCount}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                    </Border>
                </StackPanel>
            </Grid>
            
            <!-- Nhắn tin (Chat) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tự động trò chuyện (Chat)" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Mở messenger trả lời ngẫu nhiên" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsChat}" VerticalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>

            <!-- Đăng bài -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Đăng bài tự động" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Đăng bài thủ công hoặc API" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <Button Grid.Column="1" Click="BtnPostSettings_Click" Width="26" Height="26" Margin="0,0,10,0" Padding="0" Background="#f4f5f7" BorderBrush="#dadce0" BorderThickness="1" Cursor="Hand" ToolTip="Cài đặt đăng bài" VerticalAlignment="Center">
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#666" Stretch="Uniform" Width="14" Height="14"/>
                </Button>
                <CheckBox Grid.Column="2" IsChecked="{Binding IsPost}" VerticalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>

            <!-- Random Action -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Click ngẫu nhiên" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Tránh bất thường từ trình duyệt" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsRandomClick}" VerticalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>

            <!-- Chấp nhận kết bạn -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Chấp nhận kết bạn" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Số lượng bạn bè" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsAcceptFriend}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50">
                        <TextBox Text="{Binding AcceptFriendCount}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Up Story -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Đăng Story" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Tự động đăng story mới" FontSize="11" Foreground="#888"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" IsEnabled="{Binding IsUpStory}">
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="200" Margin="0,0,10,0">
                            <TextBox Text="{Binding StoryFolderPath}" BorderThickness="0" Padding="5" VerticalContentAlignment="Center" Background="Transparent" ToolTip="Đường dẫn thư mục ảnh"/>
                        </Border>
                        <Button Content="Chọn thư mục" Click="BtnBrowseStoryFolder_Click" Width="90" Height="25" Background="#f4f5f7" BorderBrush="#dadce0" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsUpStory}" VerticalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>

            <!-- Xem Story -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Xem Story" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Tự động lướt xem story bạn bè" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsViewStory}" VerticalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Đóng" Width="80" Height="30" Background="#1a73e8" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
