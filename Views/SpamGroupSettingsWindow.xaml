<Window x:Class="FPlusClone.Views.SpamGroupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt nâng cao (Spam Group)" Height="450" Width="450" WindowStartupLocation="CenterOwner" Background="#f0f0f0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Cài đặt nâng cao" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Số comment / tài khoản" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Giới hạn tối đa" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                        <TextBox Text="{Binding MaxComments}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Delay chuyển đổi tài khoản " FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                            <TextBox Text="{Binding DelayAccountMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                            <TextBox Text="{Binding DelayAccountMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nghỉ giữa comment" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Khoảng thời gian random" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                            <TextBox Text="{Binding DelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                            <TextBox Text="{Binding DelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Lặp lại tiến trình" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Số vòng lặp" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsRepeat}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50">
                            <TextBox Text="{Binding RepeatCount}" IsEnabled="{Binding IsRepeat}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sửa comment sau đăng" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Chỉnh sửa nội dung để lách spam" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding EditAfterPost}" VerticalAlignment="Center">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                </Grid>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Check phê duyệt" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Kiểm tra trạng thái bình luận" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsCheckApproval}" VerticalAlignment="Center">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                </Grid>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Số luồng chạy đồng thời" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Mở bao nhiêu tab cùng lúc" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50" VerticalAlignment="Center">
                        <TextBox Text="{Binding MaxThreads}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                    </Border>
                </Grid>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Reset DCOM lấy IP mới" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Sau n lần (chỉ KiotProxy)" FontSize="11" Foreground="#888"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsResetDcom}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50">
                            <TextBox Text="{Binding ResetDcomAfter}" IsEnabled="{Binding IsResetDcom}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Đóng" Width="80" Height="30" Background="#1a73e8" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
